{
  "expo": {
    "name": "Glideboard",
    "slug": "glideboard",
    "scheme": "vibecode",
    "version": "1.2.7",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Glideboard accesses your photos so you can choose a profile picture.",
        "NSMicrophoneUsageDescription": "Glideboard uses the microphone to count your reps out loud during voice workouts.",
        "NSMotionUsageDescription": "Glideboard uses motion sensors to automatically count your reps as you exercise."
      },
      "bundleIdentifier": "com.robertcaldwell.vibecode",
      "buildNumber": "47"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.robertcaldwell.vibecode",
      "versionCode": 272,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./icon.png",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd83d448-f493-4b71-8d6e-98f176dc3812"
      }
    },
    "owner": "rcaldwellrc1"
  }
}
